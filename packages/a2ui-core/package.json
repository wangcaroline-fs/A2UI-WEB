    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@a2ui/web_core": "^0.12.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
