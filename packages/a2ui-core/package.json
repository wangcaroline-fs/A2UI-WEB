    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./parser": {
      "types": "./dist/parser/index.d.ts",
      "import": "./dist/parser/index.js"
    },
    "./vNode": {
      "types": "./dist/vNode/index.d.ts",
      "import": "./dist/vNode/index.js"
    },
